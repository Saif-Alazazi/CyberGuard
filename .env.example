# Copy to .env and fill in. Every key is optional: a missing key skips that layer with a visible note.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
URLHAUS_AUTH_KEY=
IPINFO_TOKEN=
SERPAPI_KEY=
# Optional: require X-API-Key on /api/batch and /api/watchers/run
CYBERGUARD_API_KEY=
# Optional: binary fraud threshold (calibrated default in app/config.py)
CYBERGUARD_THRESHOLD=
