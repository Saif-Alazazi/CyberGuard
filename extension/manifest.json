{
  "manifest_version": 3,
  "name": "CyberGuard — Scam Link Check",
  "version": "1.0",
  "description": "Checks the page you are on against the live CyberGuard engine and shows a red/green scam verdict with reasons.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberGuard — check this page"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://cyberguard-m7tq.onrender.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
